# ==============================================================================
# MahaSetu RPA Ecosystem - Environment Configuration
# ==============================================================================

# Server Network Settings
PORT=5000
HOST=0.0.0.0
FLASK_ENV=production
DEBUG=false

# Security
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# Cross-Origin Resource Sharing (CORS)
# Set to '*' to allow all origins, or comma-separated list: https://domain1.com,https://domain2.com
CORS_ORIGINS=*

# Playwright & Browser Automation Settings
# Set to 'true' in headless cloud servers (Docker, Render, AWS, etc.)
PLAYWRIGHT_HEADLESS_DEFAULT=true
# Optional custom path to Chrome/Chromium executable
CHROME_PATH=

# Data Persistence Directory (Default: backend/data)
# DATA_DIR=/var/data/mahasetu
